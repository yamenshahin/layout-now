{
	"name": "layout-now",
	"version": "0.1.0",
	"private": true,
	"description": "Admin app for the Layout Now WordPress plugin.",
	"author": "Yamen Shahin",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build ./admin/src/index.js --output-path=./admin/build",
		"start": "wp-scripts start ./admin/src/index.js --output-path=./admin/build",
		"lint:js": "wp-scripts lint-js ./admin/src",
		"lint:css": "wp-scripts lint-style \"./admin/src/**/*.scss\"",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"layout-now.php",
		"uninstall.php",
		"readme.txt",
		"license.txt",
		"package.json",
		"src",
		"templates",
		"assets",
		"languages",
		"admin/build",
		"admin/src"
	],
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0"
	}
}
